{
  "name": "matterbridge-hubspace",
  "displayName": "Matterbridge Hubspace",
  "version": "0.1.0",
  "description": "Matterbridge plugin for controlling Hubspace devices.",
  "homepage": "https://github.com/kirchmeyer/matterbridge-hubspace#readme",
  "author": "Joel Kirchmeyer",
  "contributors": [
    "Adam Simonicek",
    "Cyrus Keck"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchmeyer/matterbridge-hubspace.git"
  },
  "bugs": {
    "url": "https://github.com/kirchmeyer/matterbridge-hubspace/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ACKNOWLEDGEMENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "*.config.json",
    "*.schema.json"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "start": "matterbridge",
    "add": "matterbridge --add .",
    "remove": "matterbridge --remove .",
    "watch": "tsc --watch",
    "build": "rimraf ./dist && tsc",
    "package": "npm run lint && npm run build && node scripts/package.mjs",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "matterbridge",
    "matter",
    "hubspace",
    "home-depot",
    "afero",
    "smart-home"
  ],
  "dependencies": {
    "axios": "^1.19.0",
    "color-convert": "^2.0.1"
  },
  "devDependencies": {
    "@types/color-convert": "^2.0.4",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.57.1",
    "matterbridge": "3.10.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0"
  }
}
